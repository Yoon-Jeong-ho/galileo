*.parquet
results/

# Paper artifacts (tracked)
# We generally ignore large csv outputs, but we DO want to version small, paper-ready
# snapshots used in the draft (e.g., Table W seed1).
!docs/paper/artifacts/
!docs/paper/artifacts/**
!docs/paper/artifacts/**/*.csv

# Scratch / staging
tmp/
tmp_untracked/
_tmp_results_paper/
tmp_results_paper/

# Local build artifacts occasionally created by SVG->PDF conversion; keep repo clean.
/paper_figures/pdf/cross_family_survival_r5_control_vs_logicaltrap_seed1-2_20260212.pdf
/paper_figures/pdf/cross_family_survival_r5_control_vs_logicaltrap_seed1-2_20260217.pdf

# Generated paper analysis exports (keep curated tables/figures, ignore throwaway summaries)
# NOTE: tier1_*_survival_summary_*.csv are small, reviewer-facing cross-family snapshots and ARE tracked.
docs/paper/artifacts/*_summary_*.csv
!docs/paper/artifacts/tier1_*_survival_summary_*.csv

# User-local tools (no-sudo environments)
tools/inkscape/

# OS
.DS_Store

# downloaded LaTeX style files (generated)
docs/paper/acl_style_files/

# generated PDFs for LaTeX skeletons (regenerate via scripts/sync_pdf_figures_to_latex_skeleton.sh)
# By default we ignore PDFs in the LaTeX skeleton figure folders, but we *do* track a small
# set of symlinked, paper-ready snapshots so the skeleton compiles out-of-the-box.
docs/paper/latex_skeleton/figures/*.pdf
docs/paper/latex_skeleton_emnlp2023/figures/*.pdf
!docs/paper/latex_skeleton_emnlp2023/figures/protocol_overview.pdf
!docs/paper/latex_skeleton_emnlp2023/figures/cross_family_survival_r5_control_vs_logicaltrap_seed1-2_20260210.pdf
!docs/paper/latex_skeleton_emnlp2023/figures/decoding_sweep_qwen_delta_seed1-2_20260211.pdf
