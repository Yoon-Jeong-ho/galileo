# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Conda / venv
.env
.venv
conda-meta/

# Logs & outputs
logs/
wandb/
runs/
*.log

# Checkpoints / models
*.pt
*.ckpt
*.bin
*.safetensors

# Datasets
data/
datasets/
*.jsonl
